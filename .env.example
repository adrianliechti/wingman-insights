COMPANION_API_ISSUER=
COMPANION_API_AUDIENCE=
# JWT groups-claim value required for the org-wide dashboard endpoints and to
# enable the full dashboard in the SPA. Leave empty to give everyone the
# personal-usage view only.
INSIGHTS_ADMIN_GROUP=
# Dev only (INSIGHTS_AUTH_DISABLED=true): show the org-wide dashboard for the
# local "dev" user. Defaults to personal-only, matching production.
INSIGHTS_DEV_ADMIN=
# Optional static directory (NDJSON of alias→identity rows) resolving user.id /
# user.email to display name, department and location — the zero-config
# alternative to the Entra backend, for local/dev/demo or air-gapped setups.
# `task demo` writes insights-directory.ndjson and `task dev` auto-loads it.
# Entra, when configured, takes precedence over this file.
INSIGHTS_DIRECTORY_FILE=
# Enable read-only MCP at <INSIGHTS_BASE_PATH>/mcp. Bearer JWTs are verified;
# all tools require the same INSIGHTS_ADMIN_GROUP as the dashboard.
INSIGHTS_MCP_ENABLED=false
# Optional MCP-specific OIDC issuer and audience. Each unset value defaults to
# its COMPANION_API equivalent. INSIGHTS_ADMIN_GROUP remains shared.
INSIGHTS_MCP_ISSUER=
INSIGHTS_MCP_AUDIENCE=
# Dev only: accept unauthenticated MCP callers instead of returning 401, so
# local clients need no token plumbing. Requires INSIGHTS_AUTH_DISABLED=true
# (the server exits otherwise) and logs a warning. NEVER enable in a deployment.
INSIGHTS_MCP_AUTH_DISABLED=false
# Identity assumed for unauthenticated MCP callers when the bypass above is on.
# Defaults to "dev", which usually has no telemetry, so personal scope looks
# empty; set a real user id for non-empty data. INSIGHTS_DEV_ADMIN grants admin.
INSIGHTS_MCP_DEV_USER=
# Comma-separated browser origins allowed to call MCP. Empty rejects all
# cross-origin browser requests (proxying clients like the MCP Inspector are
# unaffected). "*" allows any origin and disables the cross-origin protection:
# browser callers still need a valid bearer token and admin group membership.
INSIGHTS_MCP_ALLOWED_ORIGINS=
