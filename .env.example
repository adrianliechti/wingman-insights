COMPANION_API_ISSUER=
COMPANION_API_AUDIENCE=
# JWT groups-claim value that grants the full org-wide dashboard. Callers
# without it see only their own personal usage. Leave empty to give everyone
# the personal-usage view only (the org-wide dashboard is then disabled).
COMPANION_ADMIN_GROUP=
# Dev only (COMPANION_AUTH_DISABLED=true): show the org-wide dashboard for the
# local "dev" user. Defaults to personal-only, matching production.
COMPANION_DEV_ADMIN=
